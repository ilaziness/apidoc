# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt requires tabs for Go source.
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# go mod tidy / go work use tab-aligned columns.
[{go.mod,go.sum,go.work,go.work.sum}]
indent_style = tab

# Make recipes must use literal tabs.
[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
